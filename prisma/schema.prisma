datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String   @default("123456")
  role        String   // "ADMIN", "OFFICER", "APPROVER", "USER"
  department  String?
  studentId   String?
  phone       String?
  avatar      String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  borrowRequests      BorrowRequest[]      @relation("UserBorrowRequests")
  approvedBorrows     BorrowRequest[]      @relation("ApproverBorrowRequests")
  requisitionRequests RequisitionRequest[] @relation("UserRequisitions")
  approvedRequisitions RequisitionRequest[] @relation("ApproverRequisitions")
  stockTransactions   StockTransaction[]
  maintenanceLogs     MaintenanceLog[]
  repackRecords       RepackRecord[]
  practiceBookings    PracticeBooking[]    @relation("UserPracticeBookings")
  approvedBookings    PracticeBooking[]    @relation("ApproverPracticeBookings")
}

model Course {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  semester        String   @default("1")
  academicYear    String   @default("2569")
  instructorName  String
  description     String?
  allocatedBudget Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requisitionRequests RequisitionRequest[]
  borrowRequests      BorrowRequest[]
  stockTransactions   StockTransaction[]
  practiceBookings    PracticeBooking[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  type        String   // "EQUIPMENT" or "CONSUMABLE"
  description String?
  items       Item[]
}

model Item {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  type          String   // "EQUIPMENT" or "CONSUMABLE"
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  unit            String   // หน่วยจัดซื้อ/สต็อกหลัก เช่น "ถุง", "กล่อง", "ห่อ", "ขวด"
  usageUnit       String?  // หน่วยย่อยที่ใช้จริง เช่น "ก้อน", "แผ่น", "กรัม", "มล."
  conversionRatio Float?   @default(1) // อัตราแปลง 1 unit = conversionRatio usageUnit เช่น 1 ห่อ = 100 แผ่น
  minStockAlert   Int      @default(5)
  location        String?
  description     String?
  imageUrl        String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assets            EquipmentAsset[]
  stockLots         StockLot[]
  stockTransactions StockTransaction[]
  borrowItems       BorrowItem[]
  requisitionItems  RequisitionItem[]
  practiceKitItems  PracticeKitItem[]
  sourceRepacks     RepackRecord[]     @relation("SourceItemRepacks")
  targetRepacks     RepackRecord[]     @relation("TargetItemRepacks")
}

model EquipmentAsset {
  id             String    @id @default(cuid())
  itemId         String
  item           Item      @relation(fields: [itemId], references: [id])
  assetCode      String    @unique // รหัสประจำชิ้นในแล็บ (Lab Internal ID) เช่น AED-01, KD-01
  govAssetCode   String?   // เลขครุภัณฑ์ทางราชการ (ยาว) เช่น 7440-001-0001/2569
  sequenceNumber Int       @default(1) // ลำดับ เช่น เครื่องที่ 1, ชิ้นที่ 2
  serialNumber   String?
  location       String?   // สถานที่จัดเก็บเฉพาะชิ้น เช่น ตู้ฉุกเฉิน ห้อง Lab 1
  receivedDate   DateTime  @default(now()) // วันที่รับเข้า
  cost           Float     @default(0)     // ราคาจัดซื้อ / มูลค่าต่อชิ้น
  imageUrl       String?   // ลิงก์รูปภาพในไดรฟ์
  status         String    @default("AVAILABLE") // "AVAILABLE", "BORROWED", "MAINTENANCE", "RETIRED"
  condition      String    @default("GOOD")      // "GOOD", "FAIR", "DAMAGED"
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  borrowItems     BorrowItem[]
  maintenanceLogs MaintenanceLog[]
}

model MaintenanceLog {
  id             String         @id @default(cuid())
  assetId        String
  asset          EquipmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  issue          String         // อาการชำรุด / ปัญหาที่พบ
  sentDate       DateTime       @default(now()) // วันที่ส่งซ่อม
  completedDate  DateTime?      // วันที่ซ่อมเสร็จ
  repairShop     String?        // ผู้รับซ่อม / ศูนย์ซ่อม / ซ่อมเอง
  repairCost     Float          @default(0) // ค่าใช้จ่ายในการซ่อม
  status         String         @default("UNDER_REPAIR") // "UNDER_REPAIR", "COMPLETED", "CANNOT_REPAIR"
  technicianNote String?        // บันทึกผลการซ่อม / หมายเหตุช่าง
  handledById    String?
  handledBy      User?          @relation(fields: [handledById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model StockLot {
  id                String    @id @default(cuid())
  itemId            String
  item              Item      @relation(fields: [itemId], references: [id])
  lotNumber         String
  quantityInitial   Int
  quantityRemaining Int
  openPackRemainder Int       @default(0) // เศษชิ้นที่เหลือในซอง/กล่องที่เปิดใช้แล้ว (Loose pieces in opened pack)
  unitCost          Float
  expiryDate        DateTime?
  receivedDate      DateTime  @default(now())
  supplier          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  stockTransactions StockTransaction[]
  repackRecords     RepackRecord[]
  boxes             StockLotBox[]
}

model StockTransaction {
  id              String    @id @default(cuid())
  itemId          String
  item            Item      @relation(fields: [itemId], references: [id])
  lotId           String?
  lot             StockLot? @relation(fields: [lotId], references: [id])
  type            String    // "IN", "OUT_REQUISITION", "ADJUSTMENT", "WRITE_OFF"
  quantity        Int
  unitCost        Float     @default(0)
  totalCost       Float     @default(0)
  courseId        String?
  course          Course?   @relation(fields: [courseId], references: [id])
  referenceNumber String?
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id])
  note            String?
  createdAt       DateTime  @default(now())
}

model BorrowRequest {
  id                 String    @id @default(cuid())
  requestNumber      String    @unique
  userId             String
  user               User      @relation("UserBorrowRequests", fields: [userId], references: [id])
  courseId           String?
  course             Course?   @relation(fields: [courseId], references: [id])
  purpose            String
  borrowDate         DateTime
  expectedReturnDate DateTime
  actualReturnDate   DateTime?
  status             String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "BORROWED", "RETURNED_COMPLETE", "RETURNED_WITH_ISSUE", "CANCELLED"
  
  approverId         String?
  approver           User?     @relation("ApproverBorrowRequests", fields: [approverId], references: [id])
  approvedAt         DateTime?
  rejectionReason    String?

  // Instructor / Advisor notification & awareness for students
  advisorName            String?   // ชื่ออาจารย์ผู้สอนหรืออาจารย์ที่ปรึกษาที่รับทราบ
  instructorAcknowledged Boolean   @default(false)
  acknowledgedAt         DateTime?

  officerId          String?
  checkedOutAt       DateTime?
  checkedInAt        DateTime?
  returnNote         String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items              BorrowItem[]
}

model BorrowItem {
  id              String          @id @default(cuid())
  borrowRequestId String
  borrowRequest   BorrowRequest   @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item            @relation(fields: [itemId], references: [id])
  assetId         String?
  asset           EquipmentAsset? @relation(fields: [assetId], references: [id])
  quantity        Int             @default(1)
  isReturned      Boolean         @default(false)
  returnCondition String?
}

model RequisitionRequest {
  id              String    @id @default(cuid())
  requestNumber   String    @unique
  userId          String
  user            User      @relation("UserRequisitions", fields: [userId], references: [id])
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id])
  purpose         String
  dateNeeded      DateTime
  status          String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "DISPENSED", "CANCELLED"

  approverId      String?
  approver        User?     @relation("ApproverRequisitions", fields: [approverId], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  // Instructor / Advisor notification & awareness for students
  advisorName            String?   // ชื่ออาจารย์ประจำวิชาหรืออาจารย์ที่ปรึกษาที่รับทราบ
  instructorAcknowledged Boolean   @default(false)
  acknowledgedAt         DateTime?

  officerId       String?
  dispensedAt     DateTime?
  totalCost       Float     @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           RequisitionItem[]
}

model RequisitionItem {
  id                   String             @id @default(cuid())
  requisitionRequestId String
  requisitionRequest   RequisitionRequest @relation(fields: [requisitionRequestId], references: [id], onDelete: Cascade)
  itemId               String
  item                 Item               @relation(fields: [itemId], references: [id])
  quantityRequested    Int
  quantityDispensed    Int                @default(0)
  unitCost             Float              @default(0)
  totalCost            Float              @default(0)
}

model PracticeKit {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  category     String            @default("หัตถการพื้นฐาน")
  description  String?
  targetCourse String?
  imageUrl     String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  items        PracticeKitItem[]
  practiceBookings PracticeBooking[]
}

model PracticeKitItem {
  id        String      @id @default(cuid())
  kitId     String
  kit       PracticeKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item        @relation(fields: [itemId], references: [id])
  quantity  Int         @default(1)
}

model RepackRecord {
  id                  String    @id @default(cuid())
  recordNumber        String    @unique // เช่น RP-2026-0001
  sourceItemId        String
  sourceItem          Item      @relation("SourceItemRepacks", fields: [sourceItemId], references: [id])
  sourceLotId         String
  sourceLot           StockLot  @relation(fields: [sourceLotId], references: [id])
  
  sourceQtyUsed       Int       // จำนวนหน่วยใหญ่ที่เบิกออกมาแพ็ค เช่น 5 ห่อ
  
  targetItemId        String?   // พัสดุปลายทาง (ถ้ามี)
  targetItem          Item?     @relation("TargetItemRepacks", fields: [targetItemId], references: [id])
  subLotNumber        String    // รหัส Sub-lot ใหม่ของแล็บ เช่น RP-GAUZE-260905-01
  unitsPerPack        Int       // จำนวนชิ้นต่อซองย่อย เช่น 10 แผ่น/ซอง หรือ 20 กรัม/ซอง
  totalPacksProduced  Int       // จำนวนซองย่อยที่ได้ทั้งหมด เช่น 50 ซอง
  
  packedDate          DateTime  @default(now()) // วันที่แบ่งบรรจุ
  sterileExpiryDate   DateTime? // วันหมดอายุหลังอบสเตอร์ไรด์
  sterilizeMethod     String?   // วิธีการทำให้ปราศจากเชื้อ เช่น "Autoclave (ไอน้ำ)", "ETO (แก๊ส)", "พร้อมใช้ไม่ต้องอบ"
  operatorId          String
  operator            User              @relation(fields: [operatorId], references: [id])
  note                String?
  createdAt           DateTime          @default(now())

  packItems           RepackPackItem[]
}

model RepackPackItem {
  id              String       @id @default(cuid())
  repackRecordId  String
  repackRecord    RepackRecord @relation(fields: [repackRecordId], references: [id], onDelete: Cascade)
  packNumber      Int          // ซองที่ 1, 2, ... N
  packCode        String       @unique // เช่น SL-GAUZE-260905-01-P01 หรือ SL-GAUZE-260905-01/01
  unitsCount      Int          // จำนวนชิ้นในซองนี้ เช่น 10 แผ่น
  status          String       @default("AVAILABLE") // "AVAILABLE", "DISPENSED", "EXPIRED", "DAMAGED"
  dispensedTo     String?      // ผู้เบิก หรือวิชาที่นำไปใช้
  dispensedAt     DateTime?
  note            String?
  createdAt       DateTime     @default(now())
}





model StockLotBox {
  id              String    @id @default(cuid())
  lotId           String
  lot             StockLot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  itemId          String
  boxCode         String    @unique // เช่น "CON-PPE-001-2569-B001"
  boxNumberInLot  Int       // ลำดับกล่องในล็อต เช่น 1, 2, ...
  boxNumberInYear Int       // ลำดับกล่องในปีนี้ เช่น 1, 2, ...
  year            String    @default("2569") // ปี พ.ศ.
  status          String    @default("IN_STOCK") // "IN_STOCK", "IN_USE", "DEPLETED"
  openedAt        DateTime?
  depletedAt      DateTime?
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([itemId, year])
  @@index([lotId])
}

model PracticeRoom {
  id          String         @id @default(cuid())
  code        String         @unique // เช่น "LAB-SIM-01"
  name        String         // เช่น "ห้องฝึกปฏิบัติการพยาบาลพื้นฐาน 1 (Skill Lab 1)"
  location    String?        // เช่น "อาคาร 2 ชั้น 3 ห้อง 2301"
  capacity    Int            @default(10)
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  slots       PracticeSlot[]
}

model PracticeSlot {
  id          String            @id @default(cuid())
  roomId      String
  room        PracticeRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date        DateTime          // วันที่เปิดรอบ (เวลา 00:00:00 UTC)
  startTime   String            // เช่น "09:00"
  endTime     String            // เช่น "12:00"
  maxCapacity Int               @default(6) // จำนวนนิสิตสูงสุดในรอบนี้
  isOpen      Boolean           @default(true) // เปิด/ปิด ให้จองได้
  closeReason String?           // เหตุผลหากปิดรอบ เช่น "ติดสอนวิชาปฏิบัติการประจำ", "ทำความสะอาด/ฆ่าเชื้อ"
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  bookings    PracticeBooking[]

  @@index([date, roomId])
}

model PracticeBooking {
  id              String         @id @default(cuid())
  bookingNumber   String         @unique // เช่น "SPB-25690907-001"
  userId          String
  user            User           @relation("UserPracticeBookings", fields: [userId], references: [id])
  slotId          String
  slot            PracticeSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  
  skillTopic      String         // หัตถการที่ต้องการฝึก เช่น "การฉีดยาและการให้สารน้ำ", "การใส่สายสวนปัสสาวะ"
  objectives      String?        // วัตถุประสงค์เพิ่มเติม
  advisorName     String?        // ชื่ออาจารย์ผู้สอนหรือที่ปรึกษาที่ให้คำรับรอง
  
  courseId        String?
  course          Course?        @relation(fields: [courseId], references: [id])
  practiceKitId   String?
  practiceKit     PracticeKit?   @relation(fields: [practiceKitId], references: [id])
  
  status          String         @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "CHECKED_IN", "COMPLETED", "CANCELLED"
  approverId      String?
  approver        User?          @relation("ApproverPracticeBookings", fields: [approverId], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  qrCodeToken     String         @unique @default(cuid()) // Unique token for Dynamic QR Code
  checkInTime     DateTime?      // เวลาที่สแกน Check-in จริง
  checkOutTime    DateTime?      // เวลาที่สแกน Check-out จริง
  actualMinutes   Int?           // จำนวนนาทีที่ฝึกปฏิบัติจริง
  
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, status])
  @@index([slotId])
}

model PracticeConfig {
  id              String   @id @default("default")
  maxAdvanceDays  Int      @default(7)  // สามารถขอล่วงหน้าได้กี่วัน (ค่าเริ่มต้น 7 วัน)
  minAdvanceHours Int      @default(12) // ต้องขอล่วงหน้าอย่างน้อยกี่ชั่วโมง
  rulesNotice     String?  // ระเบียบและข้อตกลงการเข้าใช้ห้องแล็บ
  updatedAt       DateTime @updatedAt
}

