datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String   @default("123456")
  role        String   // "ADMIN", "OFFICER", "APPROVER", "USER"
  department  String?
  studentId   String?
  phone       String?
  avatar      String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  borrowRequests      BorrowRequest[]      @relation("UserBorrowRequests")
  approvedBorrows     BorrowRequest[]      @relation("ApproverBorrowRequests")
  requisitionRequests RequisitionRequest[] @relation("UserRequisitions")
  approvedRequisitions RequisitionRequest[] @relation("ApproverRequisitions")
  stockTransactions   StockTransaction[]
  maintenanceLogs     MaintenanceLog[]
  repackRecords       RepackRecord[]
}

model Course {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  semester        String   @default("1")
  academicYear    String   @default("2569")
  instructorName  String
  description     String?
  allocatedBudget Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requisitionRequests RequisitionRequest[]
  borrowRequests      BorrowRequest[]
  stockTransactions   StockTransaction[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  type        String   // "EQUIPMENT" or "CONSUMABLE"
  description String?
  items       Item[]
}

model Item {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  type          String   // "EQUIPMENT" or "CONSUMABLE"
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  unit            String   // หน่วยจัดซื้อ/สต็อกหลัก เช่น "ถุง", "กล่อง", "ห่อ", "ขวด"
  usageUnit       String?  // หน่วยย่อยที่ใช้จริง เช่น "ก้อน", "แผ่น", "กรัม", "มล."
  conversionRatio Float?   @default(1) // อัตราแปลง 1 unit = conversionRatio usageUnit เช่น 1 ห่อ = 100 แผ่น
  minStockAlert   Int      @default(5)
  location        String?
  description     String?
  imageUrl        String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assets            EquipmentAsset[]
  stockLots         StockLot[]
  stockTransactions StockTransaction[]
  borrowItems       BorrowItem[]
  requisitionItems  RequisitionItem[]
  practiceKitItems  PracticeKitItem[]
  sourceRepacks     RepackRecord[]     @relation("SourceItemRepacks")
  targetRepacks     RepackRecord[]     @relation("TargetItemRepacks")
}

model EquipmentAsset {
  id             String    @id @default(cuid())
  itemId         String
  item           Item      @relation(fields: [itemId], references: [id])
  assetCode      String    @unique // รหัสประจำชิ้นในแล็บ (Lab Internal ID) เช่น AED-01, KD-01
  govAssetCode   String?   // เลขครุภัณฑ์ทางราชการ (ยาว) เช่น 7440-001-0001/2569
  sequenceNumber Int       @default(1) // ลำดับ เช่น เครื่องที่ 1, ชิ้นที่ 2
  serialNumber   String?
  location       String?   // สถานที่จัดเก็บเฉพาะชิ้น เช่น ตู้ฉุกเฉิน ห้อง Lab 1
  receivedDate   DateTime  @default(now()) // วันที่รับเข้า
  cost           Float     @default(0)     // ราคาจัดซื้อ / มูลค่าต่อชิ้น
  imageUrl       String?   // ลิงก์รูปภาพในไดรฟ์
  status         String    @default("AVAILABLE") // "AVAILABLE", "BORROWED", "MAINTENANCE", "RETIRED"
  condition      String    @default("GOOD")      // "GOOD", "FAIR", "DAMAGED"
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  borrowItems     BorrowItem[]
  maintenanceLogs MaintenanceLog[]
}

model MaintenanceLog {
  id             String         @id @default(cuid())
  assetId        String
  asset          EquipmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  issue          String         // อาการชำรุด / ปัญหาที่พบ
  sentDate       DateTime       @default(now()) // วันที่ส่งซ่อม
  completedDate  DateTime?      // วันที่ซ่อมเสร็จ
  repairShop     String?        // ผู้รับซ่อม / ศูนย์ซ่อม / ซ่อมเอง
  repairCost     Float          @default(0) // ค่าใช้จ่ายในการซ่อม
  status         String         @default("UNDER_REPAIR") // "UNDER_REPAIR", "COMPLETED", "CANNOT_REPAIR"
  technicianNote String?        // บันทึกผลการซ่อม / หมายเหตุช่าง
  handledById    String?
  handledBy      User?          @relation(fields: [handledById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model StockLot {
  id                String    @id @default(cuid())
  itemId            String
  item              Item      @relation(fields: [itemId], references: [id])
  lotNumber         String
  quantityInitial   Int
  quantityRemaining Int
  unitCost          Float
  expiryDate        DateTime?
  receivedDate      DateTime  @default(now())
  supplier          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  stockTransactions StockTransaction[]
  repackRecords     RepackRecord[]
}

model StockTransaction {
  id              String    @id @default(cuid())
  itemId          String
  item            Item      @relation(fields: [itemId], references: [id])
  lotId           String?
  lot             StockLot? @relation(fields: [lotId], references: [id])
  type            String    // "IN", "OUT_REQUISITION", "ADJUSTMENT", "WRITE_OFF"
  quantity        Int
  unitCost        Float     @default(0)
  totalCost       Float     @default(0)
  courseId        String?
  course          Course?   @relation(fields: [courseId], references: [id])
  referenceNumber String?
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id])
  note            String?
  createdAt       DateTime  @default(now())
}

model BorrowRequest {
  id                 String    @id @default(cuid())
  requestNumber      String    @unique
  userId             String
  user               User      @relation("UserBorrowRequests", fields: [userId], references: [id])
  courseId           String?
  course             Course?   @relation(fields: [courseId], references: [id])
  purpose            String
  borrowDate         DateTime
  expectedReturnDate DateTime
  actualReturnDate   DateTime?
  status             String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "BORROWED", "RETURNED_COMPLETE", "RETURNED_WITH_ISSUE", "CANCELLED"
  
  approverId         String?
  approver           User?     @relation("ApproverBorrowRequests", fields: [approverId], references: [id])
  approvedAt         DateTime?
  rejectionReason    String?

  // Instructor / Advisor notification & awareness for students
  advisorName            String?   // ชื่ออาจารย์ผู้สอนหรืออาจารย์ที่ปรึกษาที่รับทราบ
  instructorAcknowledged Boolean   @default(false)
  acknowledgedAt         DateTime?

  officerId          String?
  checkedOutAt       DateTime?
  checkedInAt        DateTime?
  returnNote         String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items              BorrowItem[]
}

model BorrowItem {
  id              String          @id @default(cuid())
  borrowRequestId String
  borrowRequest   BorrowRequest   @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item            @relation(fields: [itemId], references: [id])
  assetId         String?
  asset           EquipmentAsset? @relation(fields: [assetId], references: [id])
  quantity        Int             @default(1)
  isReturned      Boolean         @default(false)
  returnCondition String?
}

model RequisitionRequest {
  id              String    @id @default(cuid())
  requestNumber   String    @unique
  userId          String
  user            User      @relation("UserRequisitions", fields: [userId], references: [id])
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id])
  purpose         String
  dateNeeded      DateTime
  status          String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "DISPENSED", "CANCELLED"

  approverId      String?
  approver        User?     @relation("ApproverRequisitions", fields: [approverId], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  // Instructor / Advisor notification & awareness for students
  advisorName            String?   // ชื่ออาจารย์ประจำวิชาหรืออาจารย์ที่ปรึกษาที่รับทราบ
  instructorAcknowledged Boolean   @default(false)
  acknowledgedAt         DateTime?

  officerId       String?
  dispensedAt     DateTime?
  totalCost       Float     @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           RequisitionItem[]
}

model RequisitionItem {
  id                   String             @id @default(cuid())
  requisitionRequestId String
  requisitionRequest   RequisitionRequest @relation(fields: [requisitionRequestId], references: [id], onDelete: Cascade)
  itemId               String
  item                 Item               @relation(fields: [itemId], references: [id])
  quantityRequested    Int
  quantityDispensed    Int                @default(0)
  unitCost             Float              @default(0)
  totalCost            Float              @default(0)
}

model PracticeKit {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  category     String            @default("หัตถการพื้นฐาน")
  description  String?
  targetCourse String?
  imageUrl     String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  items        PracticeKitItem[]
}

model PracticeKitItem {
  id        String      @id @default(cuid())
  kitId     String
  kit       PracticeKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item        @relation(fields: [itemId], references: [id])
  quantity  Int         @default(1)
}

model RepackRecord {
  id                  String    @id @default(cuid())
  recordNumber        String    @unique // เช่น RP-2026-0001
  sourceItemId        String
  sourceItem          Item      @relation("SourceItemRepacks", fields: [sourceItemId], references: [id])
  sourceLotId         String
  sourceLot           StockLot  @relation(fields: [sourceLotId], references: [id])
  
  sourceQtyUsed       Int       // จำนวนหน่วยใหญ่ที่เบิกออกมาแพ็ค เช่น 5 ห่อ
  
  targetItemId        String?   // พัสดุปลายทาง (ถ้ามี)
  targetItem          Item?     @relation("TargetItemRepacks", fields: [targetItemId], references: [id])
  subLotNumber        String    // รหัส Sub-lot ใหม่ของแล็บ เช่น RP-GAUZE-260905-01
  unitsPerPack        Int       // จำนวนชิ้นต่อซองย่อย เช่น 10 แผ่น/ซอง หรือ 20 กรัม/ซอง
  totalPacksProduced  Int       // จำนวนซองย่อยที่ได้ทั้งหมด เช่น 50 ซอง
  
  packedDate          DateTime  @default(now()) // วันที่แบ่งบรรจุ
  sterileExpiryDate   DateTime? // วันหมดอายุหลังอบสเตอร์ไรด์
  sterilizeMethod     String?   // วิธีการทำให้ปราศจากเชื้อ เช่น "Autoclave (ไอน้ำ)", "ETO (แก๊ส)", "พร้อมใช้ไม่ต้องอบ"
  operatorId          String
  operator            User      @relation(fields: [operatorId], references: [id])
  note                String?
  createdAt           DateTime  @default(now())
}


