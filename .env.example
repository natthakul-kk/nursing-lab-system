# Database Connections (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Resend Email API Key (รับฟรีได้ที่ https://resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ผู้ส่งอีเมล (Sender Name & Email)
# - ช่วงทดสอบ (Free Tier): ใช้ 'Nursing Lab System <onboarding@resend.dev>'
# - เมื่อผูก Domain ตัวเองแล้ว: ใช้ 'Nursing Lab System <noreply@yourdomain.ac.th>'
EMAIL_FROM="Nursing Lab System <onboarding@resend.dev>"

# Base URL ของระบบ (ใช้สร้างลิงก์กดอนุมัติ / ปฏิเสธในอีเมล)
# - รันในเครื่องทดสอบ: http://localhost:3000
# - รันบนเซิร์ฟเวอร์จริง (Production): https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret Key สำหรับเข้ารหัส HMAC Signature ของลิงก์อนุมัติ (ป้องกันการปลอมแปลง)
APPROVAL_SECRET="generate-a-random-secret-key-for-hmac-tokens"
